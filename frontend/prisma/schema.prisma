// Prisma schema for the Next.js frontend API routes
// This mirrors the backend schema but outputs to the standard location

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id        // Clerk user ID
  email     String   @unique
  createdAt DateTime @default(now())

  resumes    Resume[]
  drafts     ResumeBuilderDraft[]
  atsRecords ATSRecord[]
  pdfExports PDFExport[]

  @@map("users")
}

model Resume {
  id             String   @id @default(uuid())
  userId         String
  originalText   String
  enhancedText   String
  jobDescription String
  pdfUrl         String
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

/// Canva-style draft save for the manual Resume Builder
model ResumeBuilderDraft {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("Untitled Resume")
  data      Json
  theme     String   @default("default")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resume_builder_drafts")
}

/// ATS analysis score record — shown as a trend graph on the dashboard
model ATSRecord {
  id        String   @id @default(uuid())
  userId    String
  score     Int
  jobRole   String?
  fileName  String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ats_records")
}

/// Tracks every PDF generated (from resume builder or optimized resume)
model PDFExport {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "builder" | "optimized"
  pdfUrl    String
  title     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pdf_exports")
}
