{
    "name": "resume-builder-service",
    "version": "1.0.0",
    "description": "AI-powered Prompt-Based Resume Builder Service — standalone backend",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "ts-node src/db/migrate.ts",
        "db:studio": "drizzle-kit studio",
        "lint": "eslint src/",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "keywords": [
        "resume",
        "ai",
        "groq",
        "llama",
        "builder"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@neondatabase/serverless": "^0.10.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "drizzle-orm": "^0.36.4",
        "express": "^4.21.1",
        "express-rate-limit": "^7.4.1",
        "groq-sdk": "^1.1.2",
        "helmet": "^8.0.0",
        "puppeteer": "^23.7.1",
        "uuid": "^10.0.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^22.9.0",
        "@types/uuid": "^10.0.0",
        "drizzle-kit": "^0.28.1",
        "eslint": "^9.14.0",
        "prettier": "^3.4.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.6.3"
    }
}